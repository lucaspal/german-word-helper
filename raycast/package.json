{
  "name": "german-article",
  "title": "German Article",
  "description": "Private Raycast command for German noun article and declension lookup via Wiktionary",
  "author": "Luca",
  "license": "MIT",
  "private": true,
  "icon": "icon.png",
  "commands": [
    {
      "name": "german-article",
      "title": "German Article",
      "description": "Look up a German noun's article, meanings, and declension",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray dev",
    "test": "jest",
    "verify:api": "node scripts/verify-api-boundaries.mjs",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@raycast/api": "^1.92.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}